# ─────────────────────────────────────────────────────────
# MBM Canteen Hub — Backend Environment Variables Example
# ─────────────────────────────────────────────────────────
# Copy this file to .env and replace the values with your actual configuration.

# Network Port Configuration
PORT=5000

# Node Environment Mode (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://your_db_user:your_db_password@your_cluster.mongodb.net/mbm_canteen

# JWT Secret for Session Authentication
# Tip: Generate a secure 32-character random string
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# CORS Allowed Origin for Frontend Client
# In Development: http://localhost:5173
# In Production: http://your-alb-dns-name.amazonaws.com
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_WWW=http://localhost:3000
