# ─────────────────────────────────────────────────────────
# MBM Canteen Hub — Frontend Environment Variables Example
# ─────────────────────────────────────────────────────────
# Copy this file to .env and replace the values with your actual configuration.
# Vite requires environment variables to be prefixed with VITE_ to be exposed to client code.

# Backend API Base URL
# In Development: http://localhost:5000/api
# In Production (Kubernetes/ALB): http://your-alb-dns-name.amazonaws.com/api
VITE_API_URL=http://localhost:5000/api
